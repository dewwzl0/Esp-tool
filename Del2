local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

-- ===== НАСТРОЙКИ =====
local LOCK_SIZE = 200 -- Увеличил зону захвата
local LOCK_DISTANCE = 300 -- Увеличил дистанцию
local ENABLED = true -- По умолчанию включен

-- ===== GUI (Бессмертный) =====
local gui = Instance.new("ScreenGui")
gui.Name = "RKN_Aim"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

-- Маленькая кнопка переключения (Можно двигать)
local toggleBtn = Instance.new("TextButton")
toggleBtn.Size = UDim2.new(0, 50, 0, 30)
toggleBtn.Position = UDim2.new(0.1, 0, 0.1, 0)
toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
toggleBtn.Text = "AIM"
toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
toggleBtn.Draggable = true -- Можно перетаскивать пальцем
toggleBtn.Active = true
toggleBtn.Parent = gui

toggleBtn.MouseButton1Click:Connect(function()
    ENABLED = not ENABLED
    toggleBtn.BackgroundColor3 = ENABLED and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
end)

-- Квадрат фиксации
local box = Instance.new("Frame")
box.Size = UDim2.new(0, LOCK_SIZE, 0, LOCK_SIZE)
box.Position = UDim2.new(0.5, -LOCK_SIZE/2, 0.5, -LOCK_SIZE/2)
box.BackgroundTransparency = 1
box.BorderSizePixel = 2
box.BorderColor3 = Color3.fromRGB(255,0,0)
box.Parent = gui

-- ===== ПОИСК ЦЕЛИ =====
local function getTarget()
    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    local closest = nil
    local shortest = math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")

            if hrp and hum and hum.Health > 0 then
                local pos, visible = camera:WorldToViewportPoint(hrp.Position)
                if visible then
                    local screenPos = Vector2.new(pos.X, pos.Y)
                    local distFromCenter = (screenPos - center).Magnitude
                    local worldDist = (camera.CFrame.Position - hrp.Position).Magnitude

                    if distFromCenter <= LOCK_SIZE/2 and worldDist <= LOCK_DISTANCE then
                        if distFromCenter < shortest then
                            shortest = distFromCenter
                            closest = hrp
                        end
                    end
                end
            end
        end
    end
    return closest
end

-- ===== AIM LOCK (Горизонтальный) =====
RunService.RenderStepped:Connect(function()
    if not ENABLED then 
        box.Visible = false
        return 
    end
    
    box.Visible = true
    local target = getTarget()

    if target then
        -- Берем позицию цели с предиктом
        local targetPos = target.Position + (target.AssemblyLinearVelocity * 0.12)
        
        -- СЕКРЕТ ГОРИЗОНТАЛИ: 
        -- Мы заставляем камеру смотреть на X и Z цели, но оставляем Y (высоту) от текущего взгляда игрока
        local lookAt = Vector3.new(targetPos.X, camera.CFrame.Position.Y, targetPos.Z)
        
        -- Мгновенный поворот без сглаживания
        camera.CFrame = CFrame.new(camera.CFrame.Position, lookAt)

        box.BorderColor3 = Color3.fromRGB(0,255,0)
    else
        box.BorderColor3 = Color3.fromRGB(255,0,0)
    end
end)
